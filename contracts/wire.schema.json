{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck.invalid/contracts/wire-v1",
  "$ref": "#/$defs/RequestEnvelope",
  "$defs": {
    "RequestEnvelope": {
      "description": "Transport envelope only. Command arguments and hub identity remain semantic dispatch checks during incremental migration. Extensions remain accepted for v1 compatibility.",
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "id": { "$ref": "#/$defs/TransportId" },
        "command": { "type": "string" },
        "args": {},
        "hubId": {}
      },
      "required": ["version", "id", "command"],
      "additionalProperties": true
    },
    "TransportId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "CommandError": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$(?![\\s\\S])" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "SuccessResponse": {
      "type": "object",
      "properties": { "version": { "const": 1 }, "id": { "$ref": "#/$defs/TransportId" }, "ok": { "const": true }, "result": {} },
      "required": ["version", "id", "ok", "result"],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": { "version": { "const": 1 }, "id": { "$ref": "#/$defs/TransportId" }, "ok": { "const": false }, "error": { "$ref": "#/$defs/CommandError" } },
      "required": ["version", "id", "ok", "error"],
      "additionalProperties": false
    },
    "ResponseEnvelope": {
      "description": "Closed v1 success/error variants. Payload semantics and exact request-ID correlation are additional boundary checks; an error never proves a mutation did not execute.",
      "oneOf": [{ "$ref": "#/$defs/SuccessResponse" }, { "$ref": "#/$defs/ErrorResponse" }]
    },
    "PiId": {
      "description": "Lossless decimal Pi identity. Positive safe-integer range remains an additional semantic guard; never coerce a numeric JSON ID to a string.",
      "$ref": "#/$defs/ChatId"
    },
    "DurableRequestId": {
      "description": "Durable mutation identity, distinct from transport correlation. Existing runtime UTF-16 length limits remain semantic checks during migration.",
      "$ref": "#/$defs/TransportId"
    },
    "CommandString": {
      "description": "Nonempty well-formed wire string. Existing UTF-16 limits, nonblank text, absolute cwd and saved host authority remain semantic checks.",
      "type": "string", "minLength": 1, "maxLength": 200000
    },
    "AdmissionMode": { "enum": ["steer", "followUp"] },
    "AdmitArgs": {
      "description": "Legacy v1 extensions remain accepted but are not forwarded to Pi; origin cannot be supplied through this command.",
      "type": "object",
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "requestId": { "$ref": "#/$defs/DurableRequestId" }, "text": { "$ref": "#/$defs/CommandString" }, "mode": { "$ref": "#/$defs/AdmissionMode" } },
      "required": ["chatId", "requestId", "text", "mode"], "additionalProperties": true
    },
    "CreateTaskArgs": {
      "description": "Legacy v1 extensions remain accepted but are not forwarded to conversation creation.",
      "type": "object",
      "properties": { "requestId": { "$ref": "#/$defs/DurableRequestId" }, "title": { "$ref": "#/$defs/CommandString" }, "machineId": { "$ref": "#/$defs/CommandString" }, "cwd": { "$ref": "#/$defs/CommandString" } },
      "required": ["requestId", "title", "machineId", "cwd"], "additionalProperties": true
    },
    "InstructionImportArgs": {
      "type": "object",
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "requestId": { "$ref": "#/$defs/DurableRequestId" }, "machineId": { "$ref": "#/$defs/CommandString" }, "cwd": { "$ref": "#/$defs/CommandString" } },
      "required": ["chatId", "requestId", "machineId", "cwd"], "additionalProperties": false
    },
    "AdmitAck": {
      "description": "Durable submission only, not generation or effect completion.",
      "type": "object", "properties": { "submissionId": { "$ref": "#/$defs/PiId" } }, "required": ["submissionId"], "additionalProperties": false
    },
    "CreateTaskAck": {
      "description": "Created/retrieved conversation only, not inference or terminal allocation.",
      "type": "object", "properties": { "chatId": { "$ref": "#/$defs/PiId" } }, "required": ["chatId"], "additionalProperties": false
    },
    "InstructionImportAck": {
      "description": "Administrative task admitted, not instructions applied. Echoed chat/request identities must additionally match the original request.",
      "type": "object",
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "requestId": { "$ref": "#/$defs/DurableRequestId" }, "taskId": { "$ref": "#/$defs/PiId" }, "admitted": { "const": true }, "completion": { "const": "not_waited" } },
      "required": ["chatId", "requestId", "taskId", "admitted", "completion"], "additionalProperties": false
    },
    "ListChatsArgs": {
      "description": "Canonical conversation scan, not a lifecycle/health catalog. Legacy request extensions remain ignored. Omitted limit defaults to 50; after is the exclusive last-scanned Pi ID.",
      "type": "object",
      "properties": { "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "after": { "$ref": "#/$defs/PiId" } },
      "required": [], "additionalProperties": true
    },
    "ChatListKind": { "enum": ["main", "task", "subagent"] },
    "ChatListLabel": { "description": "Well-formed display metadata only, not host/path authority or a command argument. No trimming/normalization of canonical metadata.", "type": "string", "maxLength": 200000 },
    "ChatListItem": {
      "description": "Read-only canonical metadata projection. Optional link IDs are display hints, never Pi ownership authority. Unknown/private fields refuse at the wire boundary.",
      "type": "object",
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "kind": { "$ref": "#/$defs/ChatListKind" }, "title": { "$ref": "#/$defs/ChatListLabel" }, "machineId": { "$ref": "#/$defs/ChatListLabel" }, "cwd": { "$ref": "#/$defs/ChatListLabel" }, "parentChatId": { "$ref": "#/$defs/PiId" }, "ownerTaskId": { "$ref": "#/$defs/PiId" } },
      "required": ["chatId", "kind", "title", "machineId", "cwd"], "additionalProperties": false
    },
    "ChatListItems": { "type": "array", "items": { "$ref": "#/$defs/ChatListItem" }, "maxItems": 100 },
    "ChatListPage": {
      "description": "Bounded scan projection, not a frozen snapshot. Items may be empty with a next cursor when scanned records lack Deck metadata. ID safety, ordering, requested limit, link pairing and last-scanned cursor consistency remain semantic checks.",
      "type": "object", "properties": { "items": { "$ref": "#/$defs/ChatListItems" }, "next": { "$ref": "#/$defs/PiId" } },
      "required": ["items"], "additionalProperties": false
    },
    "LiveViewArgs": {
      "description": "Read-only activity/progress selection; omitted chat defaults to main. Legacy ignored extensions remain accepted.",
      "type": "object", "properties": { "chatId": { "$ref": "#/$defs/PiId" } }, "required": [], "additionalProperties": true
    },
    "InstructionStatusArgs": {
      "type": "object", "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "taskId": { "$ref": "#/$defs/PiId" } }, "required": [], "additionalProperties": false
    },
    "ViewCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "GenerationPhase": { "enum": ["generating", "retrying", "deferred"] },
    "GenerationAttempt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "ActivityGeneration": {
      "type": "object", "properties": { "attempt": { "$ref": "#/$defs/GenerationAttempt" }, "phase": { "$ref": "#/$defs/GenerationPhase" } }, "required": ["attempt", "phase"], "additionalProperties": false
    },
    "ActivityToolStatus": { "enum": ["pending", "running", "done"] },
    "ActivityTool": {
      "type": "object", "properties": { "callId": { "type": "string", "maxLength": 128 }, "name": { "type": "string", "maxLength": 80 }, "status": { "$ref": "#/$defs/ActivityToolStatus" }, "taskId": { "$ref": "#/$defs/PiId" }, "nested": { "type": "boolean" } },
      "required": ["callId", "name", "status", "nested"], "additionalProperties": false
    },
    "ActivitySnapshot": {
      "description": "Bounded presentation sampled from Pi, not a lifecycle/worker-health or process-draining receipt. Existing UTF-16 label caps remain semantic guards.",
      "type": "object", "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "busy": { "type": "boolean" }, "queued": { "$ref": "#/$defs/ViewCount" }, "runTaskId": { "$ref": "#/$defs/PiId" }, "generation": { "$ref": "#/$defs/ActivityGeneration" }, "tools": { "type": "array", "items": { "$ref": "#/$defs/ActivityTool" }, "maxItems": 32 }, "omittedTools": { "$ref": "#/$defs/ViewCount" }, "compactions": { "$ref": "#/$defs/ViewCount" }, "compactionFailed": { "type": "boolean" } },
      "required": ["chatId", "busy", "queued", "tools", "omittedTools", "compactions", "compactionFailed"], "additionalProperties": false
    },
    "ProgressGeneration": {
      "type": "object", "properties": { "attempt": { "$ref": "#/$defs/GenerationAttempt" }, "phase": { "$ref": "#/$defs/GenerationPhase" }, "text": { "type": "string", "maxLength": 2048 }, "textClipped": { "const": true }, "blocksOmitted": { "$ref": "#/$defs/GenerationAttempt" }, "nonTextOmitted": { "const": true } },
      "required": ["attempt", "phase", "text"], "additionalProperties": false
    },
    "ProgressTool": {
      "type": "object", "properties": { "taskId": { "$ref": "#/$defs/PiId" }, "name": { "const": "bash" }, "text": { "type": "string", "maxLength": 512 }, "textClipped": { "const": true }, "lossyUtf8": { "const": true } },
      "required": ["taskId", "name", "text"], "additionalProperties": false
    },
    "ProgressSnapshot": {
      "description": "Replaceable provisional sample, not an append stream or effect receipt. Generation/tools require a run ID; UTF-16 text caps remain semantic guards.",
      "type": "object", "properties": { "version": { "const": 1 }, "chatId": { "$ref": "#/$defs/PiId" }, "provisional": { "const": true }, "runTaskId": { "$ref": "#/$defs/PiId" }, "generation": { "$ref": "#/$defs/ProgressGeneration" }, "tools": { "type": "array", "items": { "$ref": "#/$defs/ProgressTool" }, "maxItems": 4 }, "toolSlotsOmitted": { "const": true } },
      "required": ["version", "chatId", "provisional"], "additionalProperties": false
    },
    "InstructionSourceView": {
      "description": "Bounded labels/provenance, never instruction text. Absolute cwd, safe task ID and UTF-16 caps remain semantic checks.",
      "type": "object", "properties": { "machineId": { "type": "string", "minLength": 1, "maxLength": 80 }, "cwd": { "type": "string", "minLength": 1, "maxLength": 256 }, "path": { "const": "AGENTS.md" }, "sha256": { "$ref": "#/$defs/Sha256" }, "bytes": { "type": "integer", "minimum": 0, "maximum": 32768 }, "taskId": { "$ref": "#/$defs/PiId" }, "labelsClipped": { "const": true } },
      "required": ["machineId", "cwd", "path", "sha256", "bytes", "taskId"], "additionalProperties": false
    },
    "InstructionTaskState": { "enum": ["pending", "running", "waiting", "sleeping", "completing", "terminal"] },
    "InstructionOutcome": { "enum": ["completed", "failed", "aborted", "orphaned"] },
    "InstructionRejection": { "enum": ["offline", "unavailable", "read_failed", "effect_uncertain", "invalid", "too_large", "settings_changed", "busy"] },
    "InstructionAppliedView": {
      "type": "object", "properties": { "status": { "const": "applied" }, "source": { "$ref": "#/$defs/InstructionSourceView" } }, "required": ["status", "source"], "additionalProperties": false
    },
    "InstructionRejectedView": {
      "type": "object", "properties": { "status": { "const": "rejected" }, "reason": { "$ref": "#/$defs/InstructionRejection" } }, "required": ["status", "reason"], "additionalProperties": false
    },
    "InstructionAbortedView": {
      "type": "object", "properties": { "status": { "const": "aborted" } }, "required": ["status"], "additionalProperties": false
    },
    "InstructionResultView": { "oneOf": [{ "$ref": "#/$defs/InstructionAppliedView" }, { "$ref": "#/$defs/InstructionRejectedView" }, { "$ref": "#/$defs/InstructionAbortedView" }] },
    "InstructionTaskView": {
      "description": "Outcome/result consistency and applied-source identity are semantic checks, not live state authority.",
      "type": "object", "properties": { "taskId": { "$ref": "#/$defs/PiId" }, "state": { "$ref": "#/$defs/InstructionTaskState" }, "abortRequested": { "const": true }, "outcome": { "$ref": "#/$defs/InstructionOutcome" }, "result": { "$ref": "#/$defs/InstructionResultView" }, "resultOmitted": { "const": true } },
      "required": ["taskId", "state"], "additionalProperties": false
    },
    "InstructionSnapshot": {
      "description": "Current source and historical import task are separate samples; an applied task does not prove its source is still current.",
      "type": "object", "properties": { "version": { "const": 1 }, "chatId": { "$ref": "#/$defs/PiId" }, "source": { "anyOf": [{ "$ref": "#/$defs/InstructionSourceView" }, { "type": "null" }] }, "import": { "anyOf": [{ "$ref": "#/$defs/InstructionTaskView" }, { "type": "null" }] }, "sourceOmitted": { "const": true } },
      "required": ["version", "chatId", "source", "import"], "additionalProperties": false
    },
    "HistoryAfter": {
      "description": "Exclusive entry cursor; only the literal zero or a canonical positive safe Pi ID is accepted semantically.",
      "type": "string", "pattern": "^[0-9]{1,16}$(?![\\s\\S])"
    },
    "HistoryArgs": {
      "description": "Legacy ignored extensions remain accepted. before/after are mutually exclusive; after zero bootstraps an empty chat. Limit defaults to 100.",
      "type": "object",
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "before": { "$ref": "#/$defs/PiId" }, "after": { "$ref": "#/$defs/HistoryAfter" }, "includeActivity": { "type": "boolean" }, "includeProgress": { "type": "boolean" }, "includeInstructions": { "type": "boolean" } },
      "required": ["chatId"], "additionalProperties": true
    },
    "HistoryText": { "type": "string", "maxLength": 1048576 },
    "HistoryInputData": {
      "description": "Fields consumed by the plain renderer, not the whole Pi/input archive schema. Original capture and extension bytes are not rewritten.",
      "type": "object", "properties": { "text": { "$ref": "#/$defs/HistoryText" }, "origin": {} },
      "required": ["text"], "additionalProperties": true
    },
    "HistoryAgentOrigin": {
      "type": "object", "properties": { "kind": { "const": "task-tool" }, "chatId": { "$ref": "#/$defs/PiId" }, "taskId": { "$ref": "#/$defs/PiId" } },
      "required": ["kind", "chatId", "taskId"], "additionalProperties": true
    },
    "HistoryContentPart": {
      "description": "Unknown content types remain opaque and unrendered. Text/toolCall required-field checks are semantic, selected by type.",
      "type": "object", "properties": { "type": { "type": "string", "minLength": 1, "maxLength": 1048576 }, "text": { "$ref": "#/$defs/HistoryText" }, "name": { "$ref": "#/$defs/HistoryText" } },
      "required": ["type"], "additionalProperties": true
    },
    "HistoryMessage": {
      "description": "Compatible view of rendered message fields; provider metadata, reasoning and tool arguments remain opaque and are not rendered.",
      "type": "object", "properties": { "content": { "type": "array", "items": { "$ref": "#/$defs/HistoryContentPart" }, "maxItems": 4096 }, "stopReason": { "$ref": "#/$defs/HistoryText" }, "errorMessage": { "$ref": "#/$defs/HistoryText" }, "toolName": { "$ref": "#/$defs/HistoryText" }, "isError": { "type": "boolean" }, "details": {} },
      "required": [], "additionalProperties": true
    },
    "HistoryMessages": { "type": "array", "items": { "$ref": "#/$defs/HistoryMessage" }, "maxItems": 4096 },
    "HistoryEntry": {
      "description": "Existing v1 numeric entry IDs are preserved, unlike string cursors. Pi-owned record extensions and unknown kinds remain untouched; known rendered kinds receive additional generated payload checks.",
      "type": "object", "properties": { "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "kind": { "type": "string", "minLength": 1, "maxLength": 1048576 }, "data": {}, "model": {} },
      "required": ["id", "kind"], "additionalProperties": true
    },
    "HistoryPage": {
      "description": "Closed bounded page. Next must equal the final entry ID in scan order, never an empty-page cursor. Attached live views use generated closed contracts and request-scoped semantic validation; they remain separately sampled observations.",
      "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/HistoryEntry" }, "maxItems": 100 }, "next": { "$ref": "#/$defs/PiId" }, "activity": { "$ref": "#/$defs/ActivitySnapshot" }, "progress": { "$ref": "#/$defs/ProgressSnapshot" }, "instructions": { "$ref": "#/$defs/InstructionSnapshot" } },
      "required": ["items"], "additionalProperties": false
    },
    "StopArgs": {
      "description": "Selected-chat stop request. Legacy ignored extensions remain accepted; no durable request or cancellation-completion receipt is created.",
      "type": "object", "properties": { "chatId": { "$ref": "#/$defs/PiId" } }, "required": ["chatId"], "additionalProperties": true
    },
    "StopAck": {
      "description": "The stop was requested, not proof Pi is idle, effects drained or rolled back.",
      "type": "object", "properties": { "requested": { "const": true } }, "required": ["requested"], "additionalProperties": false
    },
    "RexStartupArgs": {
      "description": "Historical registration only. Explicit matching envelope hubId, original ownerless allocation intent and saved worker/cwd remain semantic requirements.",
      "type": "object",
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "allocationId": { "$ref": "#/$defs/RexUuid" }, "blockId": { "$ref": "#/$defs/RexBlockId" } },
      "required": ["chatId", "allocationId", "blockId"], "additionalProperties": false
    },
    "RexRegistrationObservation": { "enum": ["unbound", "matched"] },
    "RexStartupAck": {
      "description": "Historical startup ACK, not the broader read-only startup snapshot, live presence, allocation proof or input-delivery receipt. Echoed identities and explicit expected hub require separate checks.",
      "type": "object",
      "properties": { "version": { "const": 1 }, "chatId": { "$ref": "#/$defs/PiId" }, "taskId": { "$ref": "#/$defs/PiId" }, "allocationId": { "$ref": "#/$defs/RexUuid" }, "blockId": { "$ref": "#/$defs/RexBlockId" }, "registered": { "const": true }, "observation": { "$ref": "#/$defs/RexRegistrationObservation" }, "historical": { "const": true }, "live": { "const": "not_checked" } },
      "required": ["version", "chatId", "taskId", "allocationId", "blockId", "registered", "observation", "historical", "live"], "additionalProperties": false
    },
    "RexUuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])" },
    "RexSessionId": { "type": "string", "pattern": "^session:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])" },
    "RexWindowId": { "type": "string", "pattern": "^window:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])" },
    "RexBlockId": { "type": "string", "pattern": "^block:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$(?![\\s\\S])" },
    "ChatId": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$(?![\\s\\S])" },
    "NullableRexUuid": { "anyOf": [{ "$ref": "#/$defs/RexUuid" }, { "type": "null" }] },
    "RexOpenTarget": {
      "type": "object", "additionalProperties": false,
      "properties": { "executable": { "type": "string", "minLength": 1, "maxLength": 4096 }, "server": { "type": "string", "minLength": 1, "maxLength": 107 }, "hostId": { "$ref": "#/$defs/RexUuid" }, "instanceId": { "$ref": "#/$defs/RexUuid" } },
      "required": ["executable", "server", "hostId", "instanceId"]
    },
    "RexOpenArgs": {
      "type": "object", "additionalProperties": false,
      "properties": { "chatId": { "$ref": "#/$defs/PiId" }, "requestId": { "$ref": "#/$defs/RexUuid" }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 }, "target": { "$ref": "#/$defs/RexOpenTarget" } },
      "required": ["chatId", "requestId", "port"]
    },
    "RexReadArgs": {
      "type": "object", "additionalProperties": false,
      "properties": { "chatId": { "$ref": "#/$defs/PiId" } }, "required": ["chatId"]
    },
    "RexOpenDisposition": { "enum": ["admitted", "reused"] },
    "RexOpenAck": {
      "type": "object", "additionalProperties": false,
      "properties": { "version": { "const": 1 }, "chatId": { "$ref": "#/$defs/PiId" }, "requestId": { "$ref": "#/$defs/RexUuid" }, "taskId": { "$ref": "#/$defs/PiId" }, "status": { "$ref": "#/$defs/RexOpenDisposition" }, "completion": { "const": "not_waited" }, "bestEffort": { "const": true } },
      "required": ["version", "chatId", "requestId", "taskId", "status", "completion", "bestEffort"]
    },
    "RexPublicBinding": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "machineId": { "type": "string", "minLength": 1, "maxLength": 200000 }, "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "server": { "type": "string", "minLength": 1, "maxLength": 107 }, "hostId": { "$ref": "#/$defs/RexUuid" }, "instanceId": { "$ref": "#/$defs/RexUuid" },
        "sessionId": { "$ref": "#/$defs/RexSessionId" }, "windowId": { "$ref": "#/$defs/RexWindowId" }, "blockId": { "$ref": "#/$defs/RexBlockId" },
        "hubId": { "$ref": "#/$defs/RexUuid" }, "chatId": { "$ref": "#/$defs/PiId" }, "taskId": { "$ref": "#/$defs/PiId" }, "readiness": { "const": "not_checked" }
      },
      "required": ["machineId", "cwd", "server", "hostId", "instanceId", "sessionId", "windowId", "blockId", "hubId", "chatId", "taskId", "readiness"]
    },
    "RexAttemptState": { "enum": ["unallocated", "pending", "allocated", "not_allocated", "uncertain", "aborted"] },
    "RexStatusSnapshot": {
      "type": "object", "additionalProperties": false,
      "properties": { "version": { "const": 1 }, "hubId": { "$ref": "#/$defs/RexUuid" }, "chatId": { "$ref": "#/$defs/PiId" }, "taskId": { "anyOf": [{ "$ref": "#/$defs/PiId" }, { "type": "null" }] }, "status": { "$ref": "#/$defs/RexAttemptState" }, "binding": { "anyOf": [{ "$ref": "#/$defs/RexPublicBinding" }, { "type": "null" }] }, "previousBinding": { "anyOf": [{ "$ref": "#/$defs/RexPublicBinding" }, { "type": "null" }] }, "bestEffort": { "const": true } },
      "required": ["version", "hubId", "chatId", "taskId", "status", "binding", "previousBinding", "bestEffort"]
    },
    "RexAllocationPlan": {
      "description": "Native allocation input. Absolute paths, UTF-8 byte limits, socket syntax, assigned-worker authority and executable identity are additional semantic checks.",
      "type": "object",
      "properties": {
        "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "server": { "type": "string", "minLength": 1, "maxLength": 107 },
        "hostId": { "$ref": "#/$defs/RexUuid" },
        "instanceId": { "$ref": "#/$defs/RexUuid" },
        "client": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "hubId": { "$ref": "#/$defs/RexUuid" },
        "chatId": { "$ref": "#/$defs/ChatId" },
        "label": { "type": "string", "pattern": "^[ -~]{1,120}$(?![\\s\\S])" },
        "allocationId": { "$ref": "#/$defs/NullableRexUuid" },
        "sessionId": { "$ref": "#/$defs/RexSessionId" }
      },
      "required": ["executable", "server", "hostId", "instanceId", "client", "port", "hubId", "chatId", "label"],
      "additionalProperties": false
    },
    "RexCreation": {
      "description": "Retained creation evidence, not readiness. Unknown fields remain accepted for legacy compatibility but are never copied into the public binding.",
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "server": { "type": "string", "minLength": 1, "maxLength": 107 },
        "hostId": { "$ref": "#/$defs/RexUuid" },
        "instanceId": { "$ref": "#/$defs/RexUuid" },
        "sessionId": { "$ref": "#/$defs/RexSessionId" },
        "windowId": { "$ref": "#/$defs/RexWindowId" },
        "blockId": { "$ref": "#/$defs/RexBlockId" },
        "chatId": { "$ref": "#/$defs/ChatId" },
        "hubId": { "$ref": "#/$defs/RexUuid" },
        "allocationId": { "$ref": "#/$defs/NullableRexUuid" },
        "readiness": { "const": "not_checked" }
      },
      "required": ["version", "server", "hostId", "instanceId", "sessionId", "windowId", "blockId", "chatId", "hubId", "readiness"],
      "additionalProperties": true
    },
    "RexInspectionScope": {
      "type": "object",
      "properties": {
        "server": { "type": "string", "minLength": 1, "maxLength": 107 },
        "hostId": { "$ref": "#/$defs/RexUuid" },
        "instanceId": { "$ref": "#/$defs/RexUuid" },
        "sessionId": { "$ref": "#/$defs/RexSessionId" },
        "windowId": { "$ref": "#/$defs/RexWindowId" },
        "blockId": { "$ref": "#/$defs/RexBlockId" }
      },
      "required": ["server", "hostId", "instanceId", "sessionId", "windowId", "blockId"],
      "additionalProperties": false
    },
    "RexInspectionQuery": {
      "type": "object",
      "properties": {
        "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "scope": { "$ref": "#/$defs/RexInspectionScope" }
      },
      "required": ["executable", "scope"],
      "additionalProperties": false
    },
    "RexPresenceState": { "enum": ["unavailable", "identity_changed", "missing_session", "missing_terminal", "pending", "running", "exited", "conflict", "inconclusive", "cancelled"] },
    "RexInspectionObservation": {
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "scope": { "$ref": "#/$defs/RexInspectionScope" },
        "state": { "$ref": "#/$defs/RexPresenceState" },
        "exitCode": { "anyOf": [{ "type": "integer", "minimum": -2147483648, "maximum": 2147483647 }, { "type": "null" }] },
        "revision": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }] }
      },
      "required": ["version", "scope", "state", "exitCode", "revision"],
      "additionalProperties": false
    },
    "RexInspectionStatus": { "enum": ["sampled", "unbound", "unavailable", "conflict", "stale", "cancelled"] },
    "RexInspectionSnapshot": {
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "hubId": { "$ref": "#/$defs/RexUuid" },
        "chatId": { "$ref": "#/$defs/ChatId" },
        "requestId": { "$ref": "#/$defs/RexUuid" },
        "taskId": { "anyOf": [{ "$ref": "#/$defs/ChatId" }, { "type": "null" }] },
        "startedAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "finishedAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "status": { "$ref": "#/$defs/RexInspectionStatus" },
        "observation": { "anyOf": [{ "$ref": "#/$defs/RexInspectionObservation" }, { "type": "null" }] }
      },
      "required": ["version", "hubId", "chatId", "requestId", "taskId", "startedAtMs", "finishedAtMs", "status", "observation"],
      "additionalProperties": false
    },
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$(?![\\s\\S])" },
    "RexAllocationReceiptQuery": {
      "description": "Read-only lookup of exactly the original allocation request bytes; never dispatch that request.",
      "type": "object",
      "properties": {
        "operationId": { "$ref": "#/$defs/ChatId" },
        "request": { "type": "string", "minLength": 1, "maxLength": 131072 }
      },
      "required": ["operationId", "request"],
      "additionalProperties": false
    },
    "RexAllocationReceiptState": { "enum": ["missing", "accepted", "allocated", "not_allocated", "conflict", "inconclusive"] },
    "RexAllocationReceipt": {
      "description": "Historical native receipt evidence, not a fresh Rex observation or permission to replay.",
      "type": "object",
      "properties": {
        "version": { "const": 1 },
        "operationId": { "$ref": "#/$defs/ChatId" },
        "requestHash": { "$ref": "#/$defs/Sha256" },
        "state": { "$ref": "#/$defs/RexAllocationReceiptState" },
        "creation": { "anyOf": [{ "$ref": "#/$defs/RexCreation" }, { "type": "null" }] }
      },
      "required": ["version", "operationId", "requestHash", "state", "creation"],
      "additionalProperties": false
    }
  }
}
